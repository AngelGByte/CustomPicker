<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/calendar_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/calendar_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agenda MyPocket"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/calendar_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="No hay próximos eventos"
        android:textColor="#D7E8E2"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/calendar_event_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/calendar_event_1_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#BFE6D8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/calendar_event_1_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/calendar_event_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/calendar_event_2_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#BFE6D8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/calendar_event_2_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/calendar_event_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/calendar_event_3_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#BFE6D8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/calendar_event_3_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
